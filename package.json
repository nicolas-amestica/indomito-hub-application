{
  "name": "ind-hub-app-ngx-pri-gh",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "npm run clean && ng serve --no-hmr --port 4300",
    "clean": "rm -rf .angular/cache",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:dev": "ng build -c=dev",
    "build:prd": "ng build -c=production",
    "deploy:dev": "bash tools/deploy-spa.sh dev",
    "deploy:prd": "bash tools/deploy-spa.sh prd",
    "version:dev": "node tools/versioning.js dev",
    "version:prd": "node tools/versioning.js prd",
    "build:deploy:dev": "npm run version:dev && npm run build:dev && npm run deploy:dev",
    "build:deploy:prd": "npm run version:prd && npm run build:prd && npm run deploy:prd"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/animations": "^22.1.1",
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@primeuix/themes": "^3.0.0",
    "primeng": "^22.1.1",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@iconify-json/tabler": "^1.2.40",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/postcss": "^4.3.3",
    "fast-check": "4.9.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
